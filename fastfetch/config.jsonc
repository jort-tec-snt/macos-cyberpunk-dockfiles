{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "none"
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 4
    }
  },

  "modules": [
    {
      "type": "os",
      "key": "OS",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "UP",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "magenta"
    }
  ]
}
